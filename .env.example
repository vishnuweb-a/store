# Server-side environment for the Frontiva serverless functions (store/api/**).
#
# These are NOT build-time variables. None of them may ever be prefixed with
# VITE_ — anything VITE_-prefixed is inlined into the browser bundle and would
# publish the credential to every visitor.
#
# Copy to .env for local development (.env is gitignored); in production set
# them in the Vercel project's Environment Variables.
#
# The browser-side variables live in apps/web/.env.example and are unchanged.

# --- Airpay merchant credentials (from the Airpay merchant dashboard) --------
# The MID for this website. Configured by Airpay with:
#   Domain:       https://frontiva.online
#   Response URL: https://frontiva.online/callback/cpm/arp/collection
#   IPN URL:      https://frontiva.online/callback/cpm/arp/collection
AIRPAY_MID=366751
AIRPAY_CLIENT_ID=
AIRPAY_SECRET_KEY=
AIRPAY_API_KEY=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=

# --- Airpay merchant 2 (second account) --------------------------------------
# The same six roles as above, for the second Airpay account. Server-side only;
# never VITE_-prefixed. Leave all six empty to run with merchant 1 alone: the
# checkout then offers a single online option, exactly as before.
#
# Merchant 2 is never substituted with merchant 1's values. If any of the six is
# missing, merchant 2 is simply not offered.
#
# Configure this MID in the Airpay dashboard with:
#   Domain:       https://frontiva.online
#   Response URL: https://frontiva.online/callback/cpm/arp_frontiva/collection
#   IPN URL:      https://frontiva.online/callback/cpm/arp_frontiva/collection
AIRPAY_MID_2=
AIRPAY_CLIENT_ID_2=
AIRPAY_SECRET_KEY_2=
AIRPAY_API_KEY_2=
AIRPAY_USERNAME_2=
AIRPAY_PASSWORD_2=

# --- Airpay merchant 3 (third account) ---------------------------------------
# The same six roles again, for the third Airpay account. Server-side only;
# never VITE_-prefixed. Never substituted with merchant 1's or 2's values: if
# any of the six is missing, merchant 3 is simply not offered.
#
# Run migrations-airpay-merchant-3.sql in Supabase BEFORE these are set in
# production -- as soon as all six are present, checkout offers merchant 3
# unless AIRPAY_ENABLED_MERCHANTS leaves it out.
#
# Configure this MID in the Airpay dashboard with the same URL as merchant 2
# (deliberately shared; the merchant is told apart by MID and envelope key):
#   Domain:       https://frontiva.online
#   Response URL: https://frontiva.online/callback/cpm/arp_frontiva/collection
#   IPN URL:      https://frontiva.online/callback/cpm/arp_frontiva/collection
AIRPAY_MID_3=
AIRPAY_CLIENT_ID_3=
AIRPAY_SECRET_KEY_3=
AIRPAY_API_KEY_3=
AIRPAY_USERNAME_3=
AIRPAY_PASSWORD_3=

# Optional. Which merchants the checkout may START a new payment on, as a
# comma-separated list. Unset means every configured merchant (1,2,3).
# Set to 1,2 to stop new merchant 3 payments -- orders already placed on
# merchant 3 are still verified with merchant 3's credentials, so keep those.
AIRPAY_ENABLED_MERCHANTS=

# Optional. The callback path each merchant's payment request names as its
# return URL. Must equal what that MID's Airpay dashboard registers, and may
# only be one of the two paths this site serves:
#   /callback/cpm/arp/collection            (default for merchant 1)
#   /callback/cpm/arp_frontiva/collection   (default for merchants 2 and 3)
# Change merchant 1's only after its Airpay dashboard has been repointed.
AIRPAY_CALLBACK_PATH=
AIRPAY_CALLBACK_PATH_2=
AIRPAY_CALLBACK_PATH_3=/callback/cpm/arp_frontiva/collection

# Optional, default false. When true, a callback for an order that is not in
# Frontiva's database is checked against Airpay's Order Confirmation API and
# the verified outcome is logged. Nothing is settled or stored either way.
AIRPAY_VERIFY_EXTERNAL_CALLBACKS=false

# 'live' or 'sandbox'. Shared by every merchant.
AIRPAY_ENV=live

# Optional. Airpay's Order Confirmation endpoint, if the merchant is onboarded
# onto a non-default path. Leave unset to use the documented v4 default.
AIRPAY_VERIFY_URL=

# Optional, default false. When true, an ap_SecureHash mismatch blocks the
# callback from triggering settlement.
#
# Left off deliberately: the exact hash construction is not in Airpay's public
# documentation, so a wrong formula would reject every genuine callback, and the
# secret it is keyed with (privatekey) is posted from the browser as part of the
# hosted-page form. It is safe to leave off because settlement never trusts the
# callback body anyway -- it re-verifies against Airpay's Order Confirmation API.
# Turn on once the construction is confirmed with Airpay.
AIRPAY_ENFORCE_SECURE_HASH=false

# Optional. The storefront checkout does not collect an email address, and
# Airpay requires one. Set a merchant-owned mailbox here.
AIRPAY_FALLBACK_BUYER_EMAIL=orders@frontiva.online

# --- SabPaisa PG 3.0 (fourth online gateway) ---------------------------------
# Server-side only; never VITE_-prefixed. Production API only: requests always
# go to https://merchant-api.sabpaisa.in. There is no staging switch, and a
# sandbox key (sk_test_...) is refused.
#
# Run migrations-sabpaisa.sql in Supabase BEFORE setting SABPAISA_ENABLED=true.
#
# No SabPaisa webhook or callback is configured. Payments are confirmed only by
# server-side Transaction Enquiry, from /success and from reconciliation, so
# the reconcile schedule below is REQUIRED once SabPaisa is enabled.
#
# Legacy spellings are also read, so an existing environment keeps working:
#   SUBPAISA_API_KEY / SUBPAISA_SECRET_KEY / SUBPAISA_CLIENT_CODE, and
#   MERCHANT_ID for the merchant ID. The SABPAISA_* name wins when both are set.
SABPAISA_API_KEY=
SABPAISA_SECRET_KEY=
SABPAISA_MERCHANT_ID=
SABPAISA_CLIENT_CODE=

# Only an explicit `true` offers SabPaisa at checkout. Setting it back to false
# stops NEW SabPaisa payments only; orders already started are still verified
# while the credentials above remain set.
SABPAISA_ENABLED=false

# Optional. Ignored unless it equals https://merchant-api.sabpaisa.in -- the
# health endpoint flags any other value. Listed only so a stale staging value is
# noticed.
SABPAISA_BASE_URL=https://merchant-api.sabpaisa.in

# Optional. Origin of the returnUrl (<origin>/success?ref=...). Must match the
# return URL approved on the SabPaisa account. Default https://frontiva.online.
SABPAISA_RETURN_ORIGIN=https://frontiva.online

# Optional. customerEmail sent to SabPaisa. Checkout collects no email, so this
# is a merchant-owned mailbox (falls back to AIRPAY_FALLBACK_BUYER_EMAIL).
SABPAISA_BUYER_EMAIL=

# --- Frontiva PayIn (fifth online gateway) ------------------------------------
# Server-side only; never VITE_-prefixed. Portal API login; the access token and
# client secret come from the login response and are held in memory only.
#
# Run migrations-frontiva-payin.sql BEFORE setting FRONTIVA_PAYIN_ENABLED=true.
# No PayIn webhook/callback: payments are confirmed only by the portal status
# endpoint, from /success and from POST /api/payments/frontiva-payin/reconcile,
# which must be scheduled (Bearer $CRON_SECRET) like the main reconcile.
FRONTIVA_PAYIN_ENABLED=false
FRONTIVA_PAYIN_BASE_URL=https://portal.frontiva.online
FRONTIVA_PAYIN_EMAIL=
FRONTIVA_PAYIN_PASSWORD=
# Required. Login is refused unless data.user.merchantId equals this.
FRONTIVA_PAYIN_EXPECTED_MERCHANT_ID=
# Required to start payments. UPI payee address(es) (the `pa` of the provider's
# upi://pay intent) a checkout QR may pay, comma separated. Any other payee is
# refused, so a forged intent cannot send a customer's money elsewhere. Confirm
# the value with the provider; the verified sample showed
# frontivatrading373991.apy@rbl.
FRONTIVA_PAYIN_ALLOWED_PAYEES=

# --- Supabase ---------------------------------------------------------------
# Same project the storefront already uses.
SUPABASE_URL=

# Required for online payments: the functions write pending orders and read the
# payment_events table, which is closed to the anon key by RLS.
SUPABASE_SERVICE_ROLE=

# Optional fallback only. Not sufficient for payment_events.
SUPABASE_ANON_KEY=

# --- Site -------------------------------------------------------------------
# Canonical production origin, no trailing slash. MUST exactly match the domain
# registered against Airpay MID 366751 (apex, no www) -- Airpay validates it.
PUBLIC_SITE_ORIGIN=https://frontiva.online

# Required. Bearer token for POST /api/payments/reconcile and for the live
# OAuth probe on GET /api/health. Compared in constant time; when
# unset, both endpoints deny. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Auxiliary callback relay ------------------------------------------------
# The client's existing endpoint, which receives a verbatim copy of every Airpay
# callback Frontiva receives, from either merchant. Optional: the code falls back
# to this same value as a server-side constant. Server-only -- never a VITE_
# variable.
#
# This relay is auxiliary. Its outcome never affects payment settlement.
KKCHAT_CALLBACK_URL=https://kkchat.in/callback/cpm/arp_frontiva/collection
